{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "adminUsername": {
      "value": "${AZURE_VM_ADMIN_USERNAME=azureadmin}"
    },
    "adminPassword": {
      "value": "${WIN11_ADMIN_PASSWORD}"
    },
    "enableCustomDnsSuffix": {
      "value": "${ENABLE_CUSTOM_DNS_SUFFIX=false}"
    }
  }
}
